# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local

# Database and upload backups. docs/admin/backup-restore.md tells the operator to run
# `pg_dump -Fc` and `tar czf` from the repository directory, so a ~34 MB UNENCRYPTED copy
# of every record in the CRM — contacts, deal values, notes, API keys — lands here by
# design. These two entries block the obvious next mistake rather than merely discouraging
# it. Store backups off the app host; never commit one.
*.dump
pipelite-uploads-*.tar.gz

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.planning
# CocoIndex Code (ccc)
/.cocoindex_code/
# Playwright MCP logs/screenshots
.playwright-mcp/

# Playwright e2e
# /e2e/.auth/ holds a LIVE Auth.js JWT session cookie (7-day maxAge) written by
# e2e/auth.setup.ts. Committing it would publish a working admin session.
/e2e/.auth/
/playwright-report/
/test-results/

# Claude Code agent worktrees live here (isolation="worktree" creates
# .claude/worktrees/agent-<id> INSIDE the repo). Committing them would commit
# a nested checkout. settings.local.json is per-machine.
/.claude/worktrees/
/.claude/settings.local.json
