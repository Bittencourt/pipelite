# Database
DATABASE_URL="postgresql://user:password@localhost:5432/pipelite"

# Postgres (required by docker-compose.yml)
# All three are interpolated by docker-compose.yml and the stack will not start without
# them — copying this file with these left blank is enough to fail step 1 of
# docs/admin/backup-restore.md on a clean host. DATABASE_URL above must AGREE with them,
# and inside Docker its host is `postgres` (the compose service name), not localhost:
#   DATABASE_URL="postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>"
POSTGRES_USER="pipelite"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="pipelite"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# SMTP (email)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
EMAIL_FROM="noreply@example.com"

# Redis (optional, for session caching)
REDIS_URL="redis://localhost:6379"

# File uploads (FILE_STORAGE=local, the default): the directory uploaded files land in.
# Set this on a BARE-METAL or PM2 install. The code's fallback is /tmp/uploads
# (src/app/api/upload/route.ts:12) and most distributions clean /tmp on a schedule, so
# leaving it unset means uploaded files disappear on their own.
# DOCKER DEPLOYMENTS: this is fixed to /app/uploads by docker-compose.yml, which mounts
# the uploads_data volume there. Setting UPLOAD_DIR in .env has NO EFFECT under Docker —
# compose hardcodes it precisely so it can never disagree with the mount target.
# Back this directory up alongside the database: docs/admin/backup-restore.md.
UPLOAD_DIR="/var/lib/pipelite/uploads"

# Internal cron route authentication (used by webhook processor)
# Generate with: openssl rand -base64 32
INTERNAL_SECRET=""

# Observability (both optional)
# Accepted values: debug | info | warn | error | silent. Default: info.
# An unrecognised value falls back to info rather than failing at boot.
LOG_LEVEL="info"
# Error tracking. Empty by default: unset means the Sentry SDK is never even
# loaded (not loaded-and-quiet), which is what keeps the self-hosted default
# from phoning home. Get the value from Sentry -> Project Settings ->
# Client Keys (DSN).
SENTRY_DSN=""
