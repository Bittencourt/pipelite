# Database — THIS IS THE HOST-SIDE CONNECTION STRING.
# docker-compose.yml publishes Postgres on the host at 5433 (`5433:5432`), so 5433 is the port
# to use from a shell on your own machine. This is the value `npx drizzle-kit migrate` and
# `npm run db:migrate` pick up when you run them from the repository root: drizzle-kit's bundled
# dotenv reads `.env` and only `.env` — it never opens `.env.local` — so this is the one file
# that decides whether the documented migrate command works.
#
# The CONTAINER's connection string is NOT this value. docker-compose.yml builds its own from
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB below, naming the compose service:
#   DATABASE_URL="postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>"
# Do NOT "fix" the line below into that form. `postgres` is a compose service name that resolves
# only inside the compose network; from the host it fails with `getaddrinfo EAI_AGAIN postgres`,
# an error that names a HOSTNAME rather than a port and is easy to misread as a port problem.
#
# Keep the user/password/database here in AGREEMENT with the POSTGRES_* values below — the same
# database is reached by both routes, just from two different sides of the network boundary.
# Not using Docker at all (bare metal / managed Postgres)? Then this is simply your own server's
# connection string; see docs/admin/configuration.md and docs/admin/deployment/bare-metal.md.
DATABASE_URL="postgresql://pipelite:change-me@localhost:5433/pipelite"

# EXTERNAL POSTGRES UNDER DOCKER — the container's connection string, and nothing else.
# Leave it EMPTY to use the bundled `postgres` service (the default, and what almost every
# self-hoster wants). Set it to reach a database that compose does not manage — RDS, Neon,
# Supabase, another host on your network:
#   APP_DATABASE_URL="postgresql://pipelite:yourpassword@your-db-host:5432/pipelite"
# docker-compose.yml reads THIS key for the app container and falls back to the bundled
# service when it is unset or empty. It is deliberately not DATABASE_URL: that key above is
# the HOST-side string, and one name cannot mean both sides of the network boundary.
# Unlike the fallback, this value is used verbatim, so percent-encode any reserved character
# in the password yourself. See docs/admin/deployment/docker.md, Step 4 Option B.
APP_DATABASE_URL=""

# Postgres (required by docker-compose.yml)
# All three are interpolated by docker-compose.yml and the stack will not start without
# them — copying this file with these left blank is enough to fail step 1 of
# docs/admin/backup-restore.md on a clean host. They are also what the app container's own
# DATABASE_URL is built from, so a typo here breaks the container and the host together.
# POSTGRES_PASSWORD is interpolated into that URL WITHOUT percent-encoding, so use only
# unreserved characters (A-Za-z0-9-._~) — a password containing / # ? % : or @ produces a
# malformed DSN and an error that names the URL, not the password. `openssl rand -hex 32`
# generates a safe one. Keep it byte-identical to the password in DATABASE_URL above.
POSTGRES_USER="pipelite"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="pipelite"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# SMTP (email)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
EMAIL_FROM="noreply@example.com"

# Redis (optional, for session caching)
REDIS_URL="redis://localhost:6379"

# File uploads (FILE_STORAGE=local, the default): the directory uploaded files land in.
# Set this on a BARE-METAL or PM2 install. The code's fallback is /tmp/uploads
# (src/app/api/upload/route.ts:12) and most distributions clean /tmp on a schedule, so
# leaving it unset means uploaded files disappear on their own.
# DOCKER DEPLOYMENTS: this is fixed to /app/uploads by docker-compose.yml, which mounts
# the uploads_data volume there. Setting UPLOAD_DIR in .env has NO EFFECT under Docker —
# compose hardcodes it precisely so it can never disagree with the mount target.
# Back this directory up alongside the database: docs/admin/backup-restore.md.
UPLOAD_DIR="/var/lib/pipelite/uploads"

# Internal cron route authentication (used by webhook processor)
# Generate with: openssl rand -base64 32
INTERNAL_SECRET=""

# Observability (both optional)
# Accepted values: debug | info | warn | error | silent. Default: info.
# An unrecognised value falls back to info rather than failing at boot.
LOG_LEVEL="info"
# Error tracking. Empty by default: unset means the Sentry SDK is never even
# loaded (not loaded-and-quiet), which is what keeps the self-hosted default
# from phoning home. Get the value from Sentry -> Project Settings ->
# Client Keys (DSN).
SENTRY_DSN=""
